# ===========================================
# VirtuEx - Staging Environment
# ===========================================

# Node
NODE_ENV=staging
LOG_LEVEL=info

# PostgreSQL
POSTGRES_HOST=stg-db.virtuex.internal
POSTGRES_PORT=5432
POSTGRES_USER=virtuex_stg
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=virtuex_stg
DATABASE_URL=postgresql://virtuex_stg:CHANGE_ME@stg-db.virtuex.internal:5432/virtuex_stg

# Redis
REDIS_HOST=stg-redis.virtuex.internal
REDIS_PORT=6379
REDIS_URL=redis://stg-redis.virtuex.internal:6379

# Kafka
KAFKA_BROKERS=stg-kafka.virtuex.internal:9092
KAFKA_CLIENT_ID=virtuex-stg

# JWT
JWT_SECRET=CHANGE_ME_STAGING_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption
ENCRYPTION_SALT=CHANGE_ME_STAGING_SALT

# Internal Service Auth
INTERNAL_SERVICE_SECRET=CHANGE_ME_STAGING_INTERNAL

# Service Ports
API_GATEWAY_PORT=3000
USER_AUTH_PORT=3007
MARKET_DATA_PORT=3001
ORDER_ENGINE_PORT=3002
PORTFOLIO_PORT=3003
NOTIFICATION_PORT=3004
CHAT_PORT=3005
AI_SERVICE_PORT=3006

# SMTP
SMTP_HOST=smtp.virtuex.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=VirtuEx <noreply@virtuex.com>

# AI (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# CORS
CORS_ORIGIN=https://stg.virtuex.com

# Frontend
NEXT_PUBLIC_API_URL=https://stg-api.virtuex.com
NEXT_PUBLIC_WS_URL=wss://stg-api.virtuex.com

# Contact (Error Page)
NEXT_PUBLIC_CONTACT_EMAIL=support@virtuex.com
NEXT_PUBLIC_CONTACT_PHONE=02-1234-5678
