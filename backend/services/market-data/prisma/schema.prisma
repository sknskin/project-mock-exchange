generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("MARKET_DATA_DATABASE_URL")
}

enum AssetType {
  STOCK
  CRYPTO
}

model Asset {
  symbol    String    @id @db.VarChar(20)
  name      String    @db.VarChar(100)
  assetType AssetType @map("asset_type")
  basePrice Decimal   @map("base_price") @db.Decimal(20, 8)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  priceHistory PriceHistory[]
  candlesticks Candlestick[]

  @@map("assets")
}

model PriceHistory {
  id        BigInt   @id @default(autoincrement())
  symbol    String   @db.VarChar(20)
  price     Decimal  @db.Decimal(20, 8)
  bid       Decimal  @db.Decimal(20, 8)
  ask       Decimal  @db.Decimal(20, 8)
  volume    Decimal  @default(0) @db.Decimal(20, 8)
  timestamp DateTime @db.Timestamptz()

  asset Asset @relation(fields: [symbol], references: [symbol])

  @@index([symbol, timestamp(sort: Desc)])
  @@map("price_history")
}

model Candlestick {
  id         BigInt   @id @default(autoincrement())
  symbol     String   @db.VarChar(20)
  interval   String   @db.VarChar(5) // 1m, 5m, 15m, 1h, 1d
  openPrice  Decimal  @map("open_price") @db.Decimal(20, 8)
  highPrice  Decimal  @map("high_price") @db.Decimal(20, 8)
  lowPrice   Decimal  @map("low_price") @db.Decimal(20, 8)
  closePrice Decimal  @map("close_price") @db.Decimal(20, 8)
  volume     Decimal  @default(0) @db.Decimal(20, 8)
  openTime   DateTime @map("open_time") @db.Timestamptz()
  closeTime  DateTime @map("close_time") @db.Timestamptz()

  asset Asset @relation(fields: [symbol], references: [symbol])

  @@unique([symbol, interval, openTime])
  @@index([symbol, interval, openTime(sort: Desc)])
  @@map("candlesticks")
}
