generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("PORTFOLIO_DATABASE_URL")
}

model Account {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  availableCash Decimal  @default(0) @map("available_cash") @db.Decimal(20, 8)
  reservedCash  Decimal  @default(0) @map("reserved_cash") @db.Decimal(20, 8)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  holdings     Holding[]
  transactions Transaction[]

  @@map("accounts")
}

model Holding {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  symbol       String   @db.VarChar(20)
  quantity     Decimal  @default(0) @db.Decimal(20, 8)
  avgCostBasis Decimal  @default(0) @map("avg_cost_basis") @db.Decimal(20, 8)
  totalCost    Decimal  @default(0) @map("total_cost") @db.Decimal(20, 8)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([userId])
  @@map("holdings")
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BUY
  SELL
  RESERVE
  RELEASE
}

model Transaction {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  type        TransactionType
  symbol      String?         @db.VarChar(20)
  quantity    Decimal?        @db.Decimal(20, 8)
  price       Decimal?        @db.Decimal(20, 8)
  cashDelta   Decimal         @map("cash_delta") @db.Decimal(20, 8)
  realizedPnl Decimal?        @map("realized_pnl") @db.Decimal(20, 8)
  referenceId String?         @unique @map("reference_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  account Account @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("transactions")
}

model Watchlist {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId  String   @map("user_id") @db.Uuid
  symbol  String   @db.VarChar(20)
  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz()

  @@unique([userId, symbol])
  @@index([userId])
  @@map("watchlists")
}
