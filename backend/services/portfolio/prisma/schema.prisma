generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("PORTFOLIO_DATABASE_URL")
}

model Account {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  availableCash Decimal  @default(0) @map("available_cash") @db.Decimal(20, 8)
  reservedCash  Decimal  @default(0) @map("reserved_cash") @db.Decimal(20, 8)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  holdings     Holding[]
  transactions Transaction[]

  @@map("accounts")
}

model Holding {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  symbol       String   @db.VarChar(20)
  quantity         Decimal  @default(0) @db.Decimal(20, 8)
  reservedQuantity Decimal  @default(0) @map("reserved_quantity") @db.Decimal(20, 8)
  avgCostBasis     Decimal  @default(0) @map("avg_cost_basis") @db.Decimal(20, 8)
  totalCost    Decimal  @default(0) @map("total_cost") @db.Decimal(20, 8)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  account Account @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([userId])
  @@map("holdings")
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BUY
  SELL
  RESERVE
  RELEASE
}

model Transaction {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  type        TransactionType
  symbol      String?         @db.VarChar(20)
  quantity    Decimal?        @db.Decimal(20, 8)
  price       Decimal?        @db.Decimal(20, 8)
  cashDelta   Decimal         @map("cash_delta") @db.Decimal(20, 8)
  realizedPnl Decimal?        @map("realized_pnl") @db.Decimal(20, 8)
  referenceId String?         @unique @map("reference_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  account Account @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("transactions")
}

model Watchlist {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId  String   @map("user_id") @db.Uuid
  symbol  String   @db.VarChar(20)
  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz()

  @@unique([userId, symbol])
  @@index([userId])
  @@map("watchlists")
}

model TraderActivity {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @db.VarChar(10)
  symbol    String   @db.VarChar(20)
  side      String   @db.VarChar(4)
  quantity  Decimal  @db.Decimal(20, 8)
  price     Decimal  @db.Decimal(20, 8)
  tradeId   String   @map("trade_id") @db.VarChar(50)
  isPublic  Boolean  @default(true) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("trader_activities")
}

model CopyTradeConfig {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  followerId      String   @map("follower_id") @db.Uuid
  traderId        String   @map("trader_id") @db.Uuid
  isActive        Boolean  @default(true) @map("is_active")
  scaleRatio      Decimal  @default(1.0) @map("scale_ratio") @db.Decimal(10, 4)
  maxInvestment   Decimal  @map("max_investment") @db.Decimal(20, 8)
  stopLossPercent Decimal? @map("stop_loss_percent") @db.Decimal(5, 2)
  totalInvested   Decimal  @default(0) @map("total_invested") @db.Decimal(20, 8)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  executions CopyTradeExecution[]

  @@unique([followerId, traderId])
  @@index([traderId, isActive])
  @@map("copy_trade_configs")
}

model CopyTradeExecution {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  configId        String   @map("config_id") @db.Uuid
  followerId      String   @map("follower_id") @db.Uuid
  traderId        String   @map("trader_id") @db.Uuid
  originalTradeId String   @map("original_trade_id") @db.VarChar(50)
  copiedOrderId   String?  @map("copied_order_id") @db.VarChar(50)
  symbol          String   @db.VarChar(20)
  side            String   @db.VarChar(4)
  originalQty     Decimal  @map("original_qty") @db.Decimal(20, 8)
  copiedQty       Decimal  @map("copied_qty") @db.Decimal(20, 8)
  price           Decimal  @db.Decimal(20, 8)
  status          String   @default("PENDING") @db.VarChar(20)
  failReason      String?  @map("fail_reason") @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  config CopyTradeConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([followerId, createdAt(sort: Desc)])
  @@index([configId])
  @@map("copy_trade_executions")
}
