generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("ORDER_ENGINE_DATABASE_URL")
}

/// CQRS Read Model - projected from Event Store
model OrderRead {
  orderId           String   @id @map("order_id") @db.VarChar(30)
  userId            String   @map("user_id") @db.Uuid
  symbol            String   @db.VarChar(20)
  side              String   @db.VarChar(4)
  orderType         String   @map("order_type") @db.VarChar(10)
  price             Decimal? @db.Decimal(20, 8)
  quantity          Decimal  @db.Decimal(20, 8)
  filledQuantity    Decimal  @default(0) @map("filled_quantity") @db.Decimal(20, 8)
  remainingQuantity Decimal  @map("remaining_quantity") @db.Decimal(20, 8)
  status            String   @db.VarChar(20)
  triggerPrice      Decimal? @map("trigger_price") @db.Decimal(20, 8)
  triggerType       String?  @map("trigger_type") @db.VarChar(20)
  triggered         Boolean  @default(false)
  idempotencyKey    String?  @unique @map("idempotency_key") @db.VarChar(255)
  createdAt         DateTime @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  lastEventPosition BigInt   @default(0) @map("last_event_position")

  @@index([userId, createdAt(sort: Desc)])
  @@index([symbol, status])
  @@index([symbol, triggerType, triggered])
  @@map("orders_read")
}

model TradeRead {
  tradeId     String   @id @map("trade_id") @db.VarChar(30)
  buyOrderId  String   @map("buy_order_id") @db.VarChar(30)
  sellOrderId String   @map("sell_order_id") @db.VarChar(30)
  buyerId     String   @map("buyer_id") @db.Uuid
  sellerId    String   @map("seller_id") @db.Uuid
  symbol      String   @db.VarChar(20)
  price       Decimal  @db.Decimal(20, 8)
  quantity    Decimal  @db.Decimal(20, 8)
  total       Decimal  @db.Decimal(20, 8)
  executedAt  DateTime @map("executed_at") @db.Timestamptz()

  @@index([symbol, executedAt(sort: Desc)])
  @@index([buyerId, executedAt(sort: Desc)])
  @@index([sellerId, executedAt(sort: Desc)])
  @@map("trades_read")
}

/// 미정산 거래 큐 — 포트폴리오 정산 실패 시 재시도 대상
/// Pending settlement queue — retry target when portfolio settlement fails
model PendingSettlement {
  id        Int      @id @default(autoincrement())
  tradeId   String   @map("trade_id") @db.VarChar(30)
  side      String   @db.VarChar(4) // BUY or SELL
  userId    String   @map("user_id") @db.Uuid
  symbol    String   @db.VarChar(20)
  quantity  String   @db.VarChar(40)
  price     String   @db.VarChar(40)
  retries   Int      @default(0)
  lastError String?  @map("last_error") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([tradeId, side])
  @@index([retries, createdAt])
  @@map("pending_settlements")
}
