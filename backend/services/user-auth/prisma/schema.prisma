generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("USER_AUTH_DATABASE_URL")
}

enum UserRole {
  SYSTEM
  ADMIN
  USER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique @db.VarChar(255)
  username      String   @unique @db.VarChar(50)
  passwordHash  String   @map("password_hash") @db.VarChar(255)
  name          String   @db.VarChar(50)
  role          UserRole @default(USER)
  isActive      Boolean  @default(true) @map("is_active")
  approvalStatus ApprovalStatus @default(PENDING) @map("approval_status")
  approvedAt     DateTime?      @map("approved_at") @db.Timestamptz()
  approvedBy     String?        @map("approved_by") @db.Uuid
  approvalNote   String?        @map("approval_note") @db.VarChar(500)
  rejectedAt     DateTime?      @map("rejected_at") @db.Timestamptz()
  rejectedBy     String?        @map("rejected_by") @db.Uuid
  rejectionNote  String?        @map("rejection_note") @db.VarChar(500)
  phone         String   @unique @db.VarChar(20)
  encryptedRrn  String   @map("encrypted_rrn") @db.VarChar(512)
  address       String   @db.VarChar(500)
  addressDetail String?  @map("address_detail") @db.VarChar(200)
  zipCode       String   @map("zip_code") @db.VarChar(10)
  totpSecret    String?    @map("totp_secret") @db.VarChar(512)
  totpEnabled   Boolean    @default(false) @map("totp_enabled")
  lockedAt      DateTime?  @map("locked_at") @db.Timestamptz()
  lockedReason  String?    @map("locked_reason") @db.VarChar(500)
  deactivatedAt DateTime?  @map("deactivated_at") @db.Timestamptz()
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  refreshTokens      RefreshToken[]
  announcements      Announcement[]
  comments           Comment[]
  notifications      Notification[]
  loginLogs          LoginLog[]
  announcementLikes  AnnouncementLike[]
  commentLikes       CommentLike[]
  priceAlerts        PriceAlert[]

  @@index([isActive, approvalStatus])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Announcement {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String   @db.VarChar(200)
  content   String   @db.Text
  authorId  String   @map("author_id") @db.Uuid
  isPinned  Boolean  @default(false) @map("is_pinned")
  viewCount Int       @default(0) @map("view_count")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  editedAt  DateTime? @map("edited_at") @db.Timestamptz()

  author      User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments    Comment[]
  attachments Attachment[]
  likes       AnnouncementLike[]

  @@index([authorId])
  @@index([createdAt])
  @@index([isPinned])
  @@map("announcements")
}

model AnnouncementLike {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  announcementId String   @map("announcement_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
  @@index([announcementId])
  @@map("announcement_likes")
}

model Attachment {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  announcementId String       @map("announcement_id") @db.Uuid
  fileName       String       @map("file_name") @db.VarChar(255)
  originalName   String       @map("original_name") @db.VarChar(255)
  mimeType       String       @map("mime_type") @db.VarChar(100)
  size           Int
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId])
  @@map("attachments")
}

model Comment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content        String   @db.VarChar(2000)
  authorId       String   @map("author_id") @db.Uuid
  announcementId String   @map("announcement_id") @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  author       User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  announcement Announcement  @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  parent       Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[]     @relation("CommentReplies")
  likes        CommentLike[]

  @@index([authorId])
  @@index([announcementId])
  @@index([parentId])
  @@map("comments")
}

model CommentLike {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  commentId String   @map("comment_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@map("comment_likes")
}

enum NotificationType {
  ANNOUNCEMENT_NEW
  ANNOUNCEMENT_UPDATED
  REGISTRATION_REQUEST
  REGISTRATION_APPROVED
  REGISTRATION_REJECTED
  GENERAL
  CHAT_MESSAGE
  PRICE_ALERT
}

enum AlertCondition {
  ABOVE
  BELOW
}

model PriceAlert {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String         @map("user_id") @db.Uuid
  symbol              String         @db.VarChar(20)
  targetPrice         Decimal        @map("target_price") @db.Decimal(20, 8)
  condition           AlertCondition
  currency            String         @default("USD") @db.VarChar(5)
  displayTargetPrice  Decimal?       @map("display_target_price") @db.Decimal(20, 2)
  isActive            Boolean        @default(true) @map("is_active")
  triggeredAt         DateTime?      @map("triggered_at") @db.Timestamptz()
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive, symbol])
  @@index([userId, symbol, isActive])
  @@map("price_alerts")
}

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType @default(GENERAL)
  title     String           @db.VarChar(200)
  message   String           @db.VarChar(500)
  link      String?          @db.VarChar(500)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model PageView {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  path      String   @db.VarChar(500)
  userId    String?  @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([path])
  @@index([createdAt])
  @@map("page_views")
}

model LoginLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("login_logs")
}

model SystemSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("system_settings")
}
