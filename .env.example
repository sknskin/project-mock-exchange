# ===========================================
# VirtuEx - 환경 변수 (Environment Variables)
# ===========================================
# 이 파일을 .env로 복사한 후 값을 입력하세요
# Copy this file to .env and fill in the values
# ⚠️  중요: 프로덕션 배포 전 모든 플레이스홀더 값을 변경하세요!
# ⚠️  IMPORTANT: Change ALL placeholder values before deploying to production!

# 노드 환경 (Node)
NODE_ENV=development

# API Gateway 내부 서비스 통신 호스트 (Service communication host)
# ⚠️ 프로덕션에서는 서비스 디스커버리 또는 내부 DNS를 사용하세요
SERVICE_HOST=localhost
LOG_LEVEL=debug

# PostgreSQL 데이터베이스
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<CHANGE_ME_IN_PRODUCTION>
POSTGRES_DB=mockexchange
DATABASE_URL=postgresql://postgres:<CHANGE_ME_IN_PRODUCTION>@localhost:5432/mockexchange

# Redis 캐시
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Kafka 메시지 브로커
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=virtuex

# JWT 인증 토큰
JWT_SECRET=<CHANGE_ME_IN_PRODUCTION>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# TOTP 2FA 암호화 키 (JWT_SECRET과 반드시 다른 값 사용)
TOTP_ENCRYPTION_KEY=<CHANGE_ME_IN_PRODUCTION>

# 암호화 솔트
ENCRYPTION_SALT=<CHANGE_ME_IN_PRODUCTION>

# 내부 서비스 인증
INTERNAL_SERVICE_SECRET=<CHANGE_ME_IN_PRODUCTION>

# 인증 설정
SALT_ROUNDS=12
LOGIN_SESSION_TTL=180
LOGIN_MAX_ATTEMPTS=5

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# HTTP 타임아웃 (밀리초)
INTERNAL_HTTP_TIMEOUT=5000

# SMS 인증코드 TTL (초)
SMS_CODE_TTL=180

# Internal Service URLs
MARKET_DATA_URL=http://localhost:3001
PORTFOLIO_URL=http://localhost:3003

# CORS
CORS_ORIGIN=http://localhost:4000

# 서비스 포트
API_GATEWAY_PORT=3000
USER_AUTH_PORT=3007
MARKET_DATA_PORT=3001
ORDER_ENGINE_PORT=3002
PORTFOLIO_PORT=3003
NOTIFICATION_PORT=3004
CHAT_PORT=3005
AI_SERVICE_PORT=3006

# SMTP 이메일 (선택 — 미설정 시 모의 전송)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VirtuEx <noreply@virtuex.com>

# AI API 키 (선택)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 모니터링 (선택)
PGADMIN_DEFAULT_EMAIL=admin@mockexchange.dev
PGADMIN_DEFAULT_PASSWORD=<CHANGE_ME_IN_PRODUCTION>
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<CHANGE_ME_IN_PRODUCTION>

# 서비스별 데이터베이스 URL (Service-specific Database URLs)
ORDER_ENGINE_DATABASE_URL=postgresql://postgres:<CHANGE_ME>@localhost:5432/mex_orders
PORTFOLIO_DATABASE_URL=postgresql://postgres:<CHANGE_ME>@localhost:5432/mex_portfolio
MARKET_DATA_DATABASE_URL=postgresql://postgres:<CHANGE_ME>@localhost:5432/mex_market
CHAT_DATABASE_URL=postgresql://postgres:<CHANGE_ME>@localhost:5432/mex_chat
USER_AUTH_DATABASE_URL=postgresql://postgres:<CHANGE_ME>@localhost:5432/mex_auth

# 프론트엔드
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# 연락처 (에러 페이지 표시용)
NEXT_PUBLIC_CONTACT_EMAIL=support@example.com
NEXT_PUBLIC_CONTACT_PHONE=000-0000-0000
