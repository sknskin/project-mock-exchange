# ===========================================
# VirtuEx - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Node
NODE_ENV=development
LOG_LEVEL=debug

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mockexchange
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mockexchange

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=virtuex

# JWT
JWT_SECRET=dev-jwt-secret-change-in-production-must-be-at-least-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption
ENCRYPTION_SALT=virtuex-salt

# Internal Service Auth
INTERNAL_SERVICE_SECRET=change-this-in-production

# Service Ports
API_GATEWAY_PORT=3000
USER_AUTH_PORT=3007
MARKET_DATA_PORT=3001
ORDER_ENGINE_PORT=3002
PORTFOLIO_PORT=3003
NOTIFICATION_PORT=3004
CHAT_PORT=3005
AI_SERVICE_PORT=3006

# AI (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# Contact (Error Page)
NEXT_PUBLIC_CONTACT_EMAIL=support@example.com
NEXT_PUBLIC_CONTACT_PHONE=000-0000-0000
