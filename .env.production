# ===========================================
# VirtuEx - Production Environment
# ===========================================
# WARNING: All secrets MUST be set via CI/CD pipeline or secret manager.
# NEVER commit actual production secrets to this file.

# Node
NODE_ENV=production
LOG_LEVEL=warn

# PostgreSQL
POSTGRES_HOST=prod-db.virtuex.internal
POSTGRES_PORT=5432
POSTGRES_USER=virtuex_prod
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=virtuex_prod
DATABASE_URL=postgresql://virtuex_prod:CHANGE_ME@prod-db.virtuex.internal:5432/virtuex_prod

# Redis
REDIS_HOST=prod-redis.virtuex.internal
REDIS_PORT=6379
REDIS_URL=redis://prod-redis.virtuex.internal:6379

# Kafka
KAFKA_BROKERS=prod-kafka.virtuex.internal:9092
KAFKA_CLIENT_ID=virtuex-prod

# JWT
JWT_SECRET=CHANGE_ME_PRODUCTION_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption
ENCRYPTION_SALT=CHANGE_ME_PRODUCTION_SALT

# Internal Service Auth
INTERNAL_SERVICE_SECRET=CHANGE_ME_PRODUCTION_INTERNAL

# Service Ports
API_GATEWAY_PORT=3000
USER_AUTH_PORT=3007
MARKET_DATA_PORT=3001
ORDER_ENGINE_PORT=3002
PORTFOLIO_PORT=3003
NOTIFICATION_PORT=3004
CHAT_PORT=3005
AI_SERVICE_PORT=3006

# SMTP
SMTP_HOST=smtp.virtuex.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=VirtuEx <noreply@virtuex.com>

# AI (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# CORS
CORS_ORIGIN=https://virtuex.com

# Frontend
NEXT_PUBLIC_API_URL=https://api.virtuex.com
NEXT_PUBLIC_WS_URL=wss://api.virtuex.com

# Contact (Error Page)
NEXT_PUBLIC_CONTACT_EMAIL=support@virtuex.com
NEXT_PUBLIC_CONTACT_PHONE=02-1234-5678
